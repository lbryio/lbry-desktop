{
  "compilerOptions": {
    // Babel does the transpilation; tsc is check-only (same role Flow had).
    "noEmit": true,
    "target": "ES2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Mirrors resolve.modules [ui/, node_modules, root] and resolve.alias
    // in webpack.base.config.js — keep the three in sync.
    // (paths resolve relative to this file; baseUrl was removed in TS 7.)
    "paths": {
      "config": ["./config.js"],
      "homepage": ["./ui/util/homepage.js"],
      "homepages/*": ["./homepages/*"],
      "memes": ["./homepages/meme/index.js"],
      "lbryinc": ["./extras/lbryinc"],
      "recsys": ["./extras/recsys"],
      "*": ["./ui/*", "./*"]
    }
  },
  // Only .ts/.tsx enter the program directly — the remaining .js files are
  // Flow-annotated and tsc cannot parse them. allowJs stays on so plain-JS
  // imports (e.g. config.js) resolve; checkJs stays off so they aren't checked.
  "include": ["types/**/*.d.ts", "ui/**/*.ts", "ui/**/*.tsx", "electron/**/*.ts", "extras/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
